{
  "name": "red-hawks-game-cow-players-api",
  "version": "1.0.0",
  "main": "app.js",
  "author": "Anthony Hurteau",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --fix",
    "dev": "npm-run-all -p clean esbuild-dev delay-sam-dev",
    "build": "npm-run-all clean esbuild",
    "delay": "sleep 6.5",
    "clean": "rimraf ./dist && rimraf ./.aws-sam",
    "esbuild-dev": "esbuild 'src/**/*.ts' --bundle --platform=node --target=node24 --sourcemap --minify --outdir=dist --watch=forever",
    "esbuild": "esbuild 'src/**/*.ts' --bundle --platform=node --target=node24 --sourcemap --minify --outdir=dist",
    "delay-sam-dev": "npm-run-all -s delay sam-dev",
    "sam-dev": "AWS_PROFILE=red-hawks-game-cow sam local start-api --template ./template.local.yaml --env-vars ./env.json --warm-containers EAGER -p 8080"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
