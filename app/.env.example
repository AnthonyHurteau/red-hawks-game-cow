# Copy to .env for local development. CI sets these itself.
VITE_ENV=dev
VITE_API_URL=https://<http-api-id>.execute-api.<region>.amazonaws.com
VITE_GAMES_PATH=games
VITE_VOTES_PATH=votes
VITE_USERS_PATH=users
VITE_PLAYERS_PATH=players
VITE_GAMES_WS_ENDPOINT=wss://<games-ws-api-id>.execute-api.<region>.amazonaws.com/<stage>
VITE_VOTES_WS_ENDPOINT=wss://<votes-ws-api-id>.execute-api.<region>.amazonaws.com/<stage>
